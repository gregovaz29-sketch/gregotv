# Gradle / build
.gradle/
build/
app/build/
/dist/
captures/
.externalNativeBuild/
.cxx/

# Android Studio / IntelliJ
.idea/
*.iml
.DS_Store

# Local SDK config (never commit)
local.properties

# APKs and signing (never commit binaries or keys)
*.apk
*.aab
*.keystore
*.jks

# Exception: the debug signing key is deliberately public. It exists so every
# build carries the same signature and can install over the previous one —
# without that, testing a Room migration is impossible, because the only way
# to install is to uninstall first and that wipes the database.
# It is DEBUG ONLY. Never ship a release signed with it. To use a private key
# instead, write it from a CI secret and set GREGOTV_KEYSTORE to its path.
!app/gregotv-debug.keystore

# Gradle wrapper jar is generated in CI, not committed
gradle/wrapper/gradle-wrapper.jar
.claude-flow/
